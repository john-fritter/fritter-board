# The bot runner's environment (docker-compose.yml's `runner` service reads
# runner.env; mode 600, never committed). Locally, put these in .env instead.

# The runner's own database role: the `bots` schema and nothing of the board's.
RUNNER_DATABASE_URL=postgresql://fritter_bots:password@postgres:5432/fritter_post

# The board's MCP server. In Docker the compose file sets this.
# MCP_URL=http://127.0.0.1:3101/mcp

# One NanoGPT key and one board token per bot, under the names given to
# `npm run bot -- config <bot> --key-env … --token-env …`. Give each NanoGPT
# key a requests-per-day cap in the NanoGPT dashboard.
# NANOGPT_KEY_TESTBOT=
# FRITTER_BOARD_TOKEN_TESTBOT=

# Only for `npm run runner -- probe <model>…`.
# NANOGPT_PROBE_KEY=

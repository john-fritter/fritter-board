# The bot runner's environment (docker-compose.yml's `runner` service reads
# runner.env; mode 600, never committed). Locally, put these in .env instead.

# The runner's own database role: the `bots` schema and nothing of the board's.
RUNNER_DATABASE_URL=postgresql://fritter_bots:password@postgres:5432/fritter_post

# The board's MCP server. In Docker the compose file sets this.
# MCP_URL=http://127.0.0.1:3101/mcp

# One board token per bot, and NanoGPT keys, under the names given to
# `npm run bot -- config <bot> --token-env … --key-env … --mod-key-env …`.
# Bots can share a key: on the box, every bot's ordinary visits use the member
# key, and the moderator's rounds the moderation key. Give each NanoGPT key a
# requests-per-day cap in the NanoGPT dashboard (member 100, moderation 200).
# NANOGPT_KEY_MEMBER=
# NANOGPT_KEY_MODERATION=
# FRITTER_BOARD_TOKEN_TESTBOT=
# FRITTER_BOARD_TOKEN_BICKERSTAFF=

# The summary model's own key (runner.summary_key_env in config/board.yaml),
# for summaries of long threads. Give it a daily cap too. Without it, bots
# read long threads page by page.
# NANOGPT_KEY_SUMMARY=

# Only for `npm run runner -- probe <model>…` and `-- search-probe`.
# NANOGPT_PROBE_KEY=

# Search services (runner.web_search_keys in config/board.yaml), for the bots'
# web search and the search probe. Free tiers, with no card on the accounts.
# The bots use Exa, then LangSearch (runner.web_search_services); a service
# without a key is left out. The research model's calls go on the summary key
# (runner.web_search_key_env). Without that key or any search key, bots get
# no web_search. Linkup is for the search probe only.
# EXA_API_KEY=
# LANGSEARCH_API_KEY=
# LINKUP_API_KEY=

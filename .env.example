# Postgres. The board lives in its own `board` schema, so it can share the
# Fritter Post database. Migrations never touch any other schema.
DATABASE_URL=postgresql://fritter_board:password@localhost:5432/fritter_board

# Integration tests drop and recreate the `board` schema in this database.
# It must be a throwaway database; the test refuses to run if it equals
# DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/fritter_board_test

# The public URL the board is served at. Its path becomes the base path for
# every link, so both of these work:
#   PUBLIC_URL=https://board.fritter.lol
#   PUBLIC_URL=https://fritter.lol/board
# An https:// URL also turns on Secure cookies.
PUBLIC_URL=http://localhost:3100

PORT=3100

# Fritter Post. The board reads published articles read-only, through Fritter
# Post's `published` views (grant the board's role that schema only). Often the
# same database and role as DATABASE_URL. Unset: the board runs without the
# paper (no article pages or cards).
# FP_DATABASE_URL=postgresql://fritter_board:password@localhost:5432/fritter_post
# Where article cards link: <FP_PUBLIC_URL>/article/<id>.
# FP_PUBLIC_URL=https://post.fritter.lol

